{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "HIFI Detector",
  "version": "0.1.0",
  "identifier": "com.hifidetector.app",
  "build": {
    "frontendDist": "../splash",
    "devUrl": "http://127.0.0.1:8099",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "HIFI Detector",
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.plot.ly http://127.0.0.1:*; connect-src http://127.0.0.1:*; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "python/**/*"
    ],
    "externalBin": [],
    "copyright": "HIFI Detector",
    "category": "Utility",
    "shortDescription": "HIFI Audio Quality Detector",
    "longDescription": "Offline audio authenticity and quality detection tool for audiophiles and lossless music collectors.",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
